# -------------------- Discord Bot --------------------
TOKEN = "YOUR_BOT_TOKEN_HERE"  # Replace with your bot token

PREFIX = "!"

intents = discord.Intents.default()
intents.message_content = True
bot = commands.Bot(command_prefix=PREFIX, intents=intents)
bypasser = OpexBypass()


@bot.event
async def on_ready():
    print(f"✅ Opex Bypass is online as {bot.user}")
    print(f"Commands: {PREFIX}bypass <url> | {PREFIX}supported")


@bot.command(name="bypass", brief="Bypass a short URL")
@commands.cooldown(1, 5, commands.BucketType.user)
async def bypass(ctx, url: str = None):
    """Bypasses a short URL and returns the original link."""
    if url is None:
        await ctx.send(f"⚠️ Please provide a URL. Usage: `{PREFIX}bypass <url>`")
        return

    if not url.startswith(('http://', 'https://')):
        url = 'http://' + url

    if not re.match(r'https?://[^\s]+', url):
        await ctx.send("❌ Invalid URL format.")
        return

    await ctx.send("🔍 Bypassing... This may take a few seconds.")
    try:
        final_url = await bot.loop.run_in_executor(None, bypasser.bypass, url)
        if final_url == url:
            await ctx.send("⚠️ Could not bypass the URL. It might not be shortened or is unsupported.")
        else:
            await ctx.send(f"✅ **Original URL:**\n{final_url}")
    except Exception as e:
        await ctx.send(f"❌ An error occurred: {e}")


@bypass.error
async def bypass_error(ctx, error):
    if isinstance(error, commands.CommandOnCooldown):
        await ctx.send(f"⏳ Cooldown active. Try again in {error.retry_after:.1f} seconds.")
    else:
        await ctx.send(f"❌ Error: {error}")


@bot.command(name="supported", brief="List supported shorteners")
async def supported(ctx):
    """Shows a list of all supported shorteners."""
    supported_list = OpexBypass.SUPPORTED_SHORTENERS
    message = "**Supported Shorteners:**\n"
    message += "\n".join(f"• {item}" for item in supported_list)
    await ctx.send(message)


# -------------------- Run Bot --------------------
if __name__ == "__main__":
    if TOKEN == "YOUR_BOT_TOKEN_HERE":
        print("❌ Please set your bot token in the TOKEN variable.")
        sys.exit(1)

    bot.run(TOKEN)
