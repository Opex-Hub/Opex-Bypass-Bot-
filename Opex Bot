import re
import sys
import discord
from discord.ext import commands
import requests
from bs4 import BeautifulSoup
from urllib.parse import urlparse

# -------------------- Bypass Logic --------------------
class OpexBypass:
    """Main class for bypassing short URLs."""

    SUPPORTED_SHORTENERS = [
        "adf.ly", "ay.gy", "j.gs",
        "sh.st", "shortest.com", "viid.me",
        "ouo.io", "ouo.press",
        "bit.ly", "tinyurl.com", "goo.gl", "t.co",
        "linkvertise.com", "link-to.net", "linkvertise.net",  # linkvertise variants
        "lootlabs.gg", "loot-link.com", "lootlabs.com",       # lootlabs variants
        "work.ink", "workink.com",                            # work.ink variants
        "any other redirect-based shortener"
    ]

    def __init__(self, timeout=10):
        self.timeout = timeout
        self.session = requests.Session()
        self.session.headers.update({
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) '
                          'AppleWebKit/537.36 (KHTML, like Gecko) '
                          'Chrome/91.0.4472.124 Safari/537.36'
        })

    def bypass(self, url: str) -> str:
        """Main entry point: tries to bypass the given short URL."""
        if not url.startswith(('http://', 'https://')):
            url = 'http://' + url

        domain = urlparse(url).netloc.lower()

        # Dispatch to specific handlers
        if any(d in domain for d in ['adf.ly', 'ay.gy', 'j.gs']):
            return self._bypass_adfly(url)
        elif any(d in domain for d in ['sh.st', 'shortest.com', 'viid.me']):
            return self._bypass_shst(url)
        elif any(d in domain for d in ['ouo.io', 'ouo.press']):
            return self._bypass_ouo(url)
        elif any(d in domain for d in ['linkvertise.com', 'link-to.net', 'linkvertise.net']):
            return self._bypass_linkvertise(url)
        elif any(d in domain for d in ['lootlabs.gg', 'loot-link.com', 'lootlabs.com']):
            return self._bypass_lootlabs(url)
        elif any(d in domain for d in ['work.ink', 'workink.com']):
            return self._bypass_workink(url)
        else:
            return self._follow_redirects(url)

    def _follow_redirects(self, url: str) -> str:
        """Follow all HTTP redirects and return the final URL."""
        try:
            resp = self.session.get(url, timeout=self.timeout, allow_redirects=True)
            return resp.url
        except Exception as e:
            print(f"[!] Error following redirects: {e}")
            return url

    def _get_page(self, url: str) -> str:
        """Fetch page content and return text."""
        try:
            resp = self.session.get(url, timeout=self.timeout)
            resp.raise_for_status()
            return resp.text
        except Exception as e:
            print(f"[!] Error fetching page: {e}")
            return ""

    # ---------- Existing handlers ----------
    def _bypass_adfly(self, url: str) -> str:
        try:
            html = self._get_page(url)
            if not html:
                return self._follow_redirects(url)

            soup = BeautifulSoup(html, 'html.parser')
            skip_btn = soup.find('a', class_='skip')
            if skip_btn and skip_btn.get('href'):
                return self._follow_redirects(skip_btn['href'])

            meta_refresh = soup.find('meta', attrs={'http-equiv': 'refresh'})
            if meta_refresh and meta_refresh.get('content'):
                content = meta_refresh['content']
                url_match = re.search(r'url=([^;]+)', content, re.IGNORECASE)
                if url_match:
                    return self._follow_redirects(url_match.group(1))

            for a in soup.find_all('a', href=True):
                href = a['href']
                if not any(d in href for d in ['adf.ly', 'ay.gy', 'j.gs']):
                    if href.startswith('http'):
                        return self._follow_redirects(href)

            return self._follow_redirects(url)
        except Exception as e:
            print(f"[!] ADF.ly bypass failed: {e}")
            return self._follow_redirects(url)

    def _bypass_shst(self, url: str) -> str:
        try:
            html = self._get_page(url)
            if not html:
                return self._follow_redirects(url)

            soup = BeautifulSoup(html, 'html.parser')
            for a in soup.find_all('a', href=True):
                href = a['href']
                if not any(d in href for d in ['sh.st', 'shortest.com', 'viid.me']):
                    if href.startswith('http'):
                        return self._follow_redirects(href)

            script_text = str(soup)
            match = re.search(r'(?:url|link|href)\s*=\s*["\']([^"\']+)["\']', script_text, re.IGNORECASE)
            if match:
                found_url = match.group(1)
                if found_url.startswith('http'):
                    return self._follow_redirects(found_url)

            return self._follow_redirects(url)
        except Exception as e:
            print(f"[!] sh.st bypass failed: {e}")
            return self._follow_redirects(url)

    def _bypass_ouo(self, url: str) -> str:
        try:
            html = self._get_page(url)
            if not html:
                return self._follow_redirects(url)

            soup = BeautifulSoup(html, 'html.parser')
            form = soup.find('form', id=re.compile('form', re.IGNORECASE))
            if form and form.get('action'):
                action = form['action']
                if action.startswith('http'):
                    return self._follow_redirects(action)

            script_text = str(soup)
            match = re.search(r'https?://[^\s"\']+', script_text)
            if match:
                found_url = match.group(0)
                if not any(d in found_url for d in ['ouo.io', 'ouo.press']):
                    return self._follow_redirects(found_url)

            return self._follow_redirects(url)
        except Exception as e:
            print(f"[!] ouo.io bypass failed: {e}")
            return self._follow_redirects(url)

    # ---------- New handlers for Linkvertise, Lootlabs, Work.ink ----------
    def _bypass_linkvertise(self, url: str) -> str:
        """
        Linkvertise bypass attempt.
        Linkvertise often hides the target link in a JavaScript variable or
        after a countdown. We try to extract it from the page source.
        """
        try:
            html = self._get_page(url)
            if not html:
                return self._follow_redirects(url)

            soup = BeautifulSoup(html, 'html.parser')

            # Look for meta refresh
            meta_refresh = soup.find('meta', attrs={'http-equiv': 'refresh'})
            if meta_refresh and meta_refresh.get('content'):
                content = meta_refresh['content']
                url_match = re.search(r'url=([^;]+)', content, re.IGNORECASE)
                if url_match:
                    return self._follow_redirects(url_match.group(1))

            # Look for links that are not linkvertise itself
            for a in soup.find_all('a', href=True):
                href = a['href']
                if not any(d in href for d in ['linkvertise.com', 'link-to.net', 'linkvertise.net']):
                    if href.startswith('http'):
                        return self._follow_redirects(href)

            # Search for common JS variables containing the final link
            script_text = str(soup)
            # Patterns like: var url = "https://..."; or data-href="https://..."
            patterns = [
                r'(?:var|let|const)\s+(?:url|link|target|destination)\s*=\s*["\']([^"\']+)["\']',
                r'data-href=["\']([^"\']+)["\']',
                r'window\.location\s*=\s*["\']([^"\']+)["\']',
                r'https?://[^\s"\']+'  # fallback to any URL
            ]
            for pattern in patterns:
                match = re.search(pattern, script_text, re.IGNORECASE)
                if match:
                    found = match.group(1) if match.lastindex else match.group(0)
                    if found.startswith('http') and not any(d in found for d in ['linkvertise.com', 'link-to.net', 'linkvertise.net']):
                        return self._follow_redirects(found)

            # If nothing found, just follow redirects
            return self._follow_redirects(url)
        except Exception as e:
            print(f"[!] Linkvertise bypass failed: {e}")
            return self._follow_redirects(url)

